<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Telerik.Blazor.UI</RootNamespace>

    <!-- NuGet package -->
    <IsPackable>true</IsPackable>
    <PackageId>Blazor.UI.Localizer</PackageId>
    <Version>1.4.0</Version>
    <Authors>Daniel Macek</Authors>
    <Company>Daniel Macek</Company>
    <Description>Compiled localization library with culture resources embedded in the main assembly for Telerik UI for Blazor community message translations.</Description>
    <PackageTags>blazor;telerik;localization;i18n;resx;messages</PackageTags>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/danmaca/blazor-ui-messages</PackageProjectUrl>
    <RepositoryUrl>https://github.com/danmaca/blazor-ui-messages</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Flatten culture folders and keep culture in the resource name (TelerikMessages.cs-CZ.resx).
      WithCulture=false embeds culture resources into the main DLL instead of satellite assemblies,
      which avoids Blazor WASM lazy-load / cold-start failures for *.resources.dll.
    -->
    <EmbeddedResource Include="..\Messages\**\*.resx"
                      Exclude="..\Messages\da-DK\**;..\Messages\nl-BE\**;..\Messages\pt-BR\**;..\Messages\zh-CN\**;..\Messages\fa-IR\**"
                      WithCulture="false">
      <Link>Messages/%(Filename)%(Extension)</Link>
    </EmbeddedResource>
  </ItemGroup>

</Project>
